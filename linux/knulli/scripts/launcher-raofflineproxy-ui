#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="/userdata/system/raofflineproxy/bin"
STATE_FILE="/userdata/system/raofflineproxy/ui-state.txt"
IMAGE_FILE="/userdata/system/raofflineproxy/ui-state.bmp"
DISPLAY_SECONDS=6

detect_resolution() {
  if [ -r /sys/class/graphics/fb0/virtual_size ]; then
    IFS=, read -r FB_WIDTH FB_HEIGHT < /sys/class/graphics/fb0/virtual_size || true
  fi

  FB_WIDTH="${FB_WIDTH:-0}"
  FB_HEIGHT="${FB_HEIGHT:-0}"
}

write_state() {
  local title="$1"
  local body="$2"

  mkdir -p "$(dirname "${STATE_FILE}")"
  cat > "${STATE_FILE}" <<EOF
${title}

${body}

Saved to:
  ${STATE_FILE}
EOF
}

show_message() {
  local title="$1"
  local body="$2"
  local message="${title}: ${body}"

  if command -v notify-send >/dev/null 2>&1; then
    notify-send "${title}" "${body}" >/dev/null 2>&1 && return 0
  fi

  if command -v batocera-es-swissknife >/dev/null 2>&1; then
    batocera-es-swissknife --message "${message}" >/dev/null 2>&1 && return 0
    batocera-es-swissknife --popup "${message}" >/dev/null 2>&1 && return 0
    batocera-es-swissknife --notification "${message}" >/dev/null 2>&1 && return 0
  fi

  return 1
}

show_image() {
  if ! command -v fbv >/dev/null 2>&1; then
    return 1
  fi

  /bin/sh -c '
    fbv -i -c -u "$1" >/dev/null 2>&1 &
    viewer_pid=$!
    sleep "$2"
    kill "$viewer_pid" >/dev/null 2>&1 || true
  ' sh "$1" "$2"
}

render_feedback() {
  local title="$1"
  local body="$2"
  local message

  detect_resolution
  write_state "${title}" "${body}"
  message="${title}

${body}

Saved to:
  ${STATE_FILE}"
  "${BIN_DIR}/raofflineproxy" text-image --output "${IMAGE_FILE}" --text "${message}" --image-width "${FB_WIDTH}" --image-height "${FB_HEIGHT}" --font-scale 2 >/dev/null 2>&1 || true
  show_image "${IMAGE_FILE}" "${DISPLAY_SECONDS}" || show_message "${title}" "See ui-state.txt" || true
}

run_status() {
  local output
  output="$("${BIN_DIR}/raofflineproxy" status 2>&1 || true)"
  render_feedback "RAOfflineProxy Status" "${output}"
}

run_start() {
  local output
  if output="$("${BIN_DIR}/raofflineproxy" start-proxy 2>&1)"; then
    render_feedback "RAOfflineProxy Start" "${output}"
  else
    render_feedback "RAOfflineProxy Start Failed" "${output}"
    return 1
  fi
}

run_stop() {
  local output
  if output="$("${BIN_DIR}/raofflineproxy" stop-proxy 2>&1)"; then
    render_feedback "RAOfflineProxy Stop" "${output}"
  else
    render_feedback "RAOfflineProxy Stop Failed" "${output}"
    return 1
  fi
}

ACTION="${1:-status}"

case "${ACTION}" in
  start)
    run_start
    ;;
  stop)
    run_stop
    ;;
  status)
    run_status
    ;;
  *)
    render_feedback "RAOfflineProxy" "Unknown action: ${ACTION}"
    exit 2
    ;;
esac
