<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_token_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_warning_box"
            android:lineSpacingMultiplier="1.15"
            android:padding="16dp"
            android:text="@string/home_token_warning"
            android:textColor="@color/warning_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Logo top-left, description text floats to its right and wraps below -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="12dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/iv_logo"
                android:layout_alignParentTop="true"
                android:gravity="top"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginTop="12dp"
                android:text="@string/home_description" />

        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp"
            android:text="@string/home_hardcore_note" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp"
            android:text="@string/home_proxy_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp"
            android:textStyle="bold"
            android:text="@string/home_shutdown_warning" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
