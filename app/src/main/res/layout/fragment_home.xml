<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_token_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_warning_box"
            android:lineSpacingMultiplier="1.15"
            android:padding="16dp"
            android:text="@string/home_no_emulator_warning"
            android:textColor="@color/warning_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Logo top-left, description text floats to its right and wraps below -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="12dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/tv_home_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/iv_logo"
                android:layout_alignParentTop="true"
                android:gravity="top"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginTop="12dp"
                android:text="@string/home_description" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_manual_setup_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_warning_box"
            android:lineSpacingMultiplier="1.15"
            android:padding="16dp"
            android:text="@string/home_manual_setup_warning"
            android:textColor="@color/warning_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_emulator_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/home_emulators_label"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_emulator_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_emulator_selector_trigger"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/emulator_selector_cd"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/layout_enabled_emulator_icons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/emulator_selector_caret"
                android:textColor="@color/emulator_toggle_text_active"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_shizuku_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_info_box"
            android:lineSpacingMultiplier="1.15"
            android:padding="16dp"
            android:text="@string/home_shizuku_info"
            android:textColor="@color/info_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_proxy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/proxy_start"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_manual_emulator_setup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_manual_emulator_setup"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_go_to_cached_games"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/home_go_to_cached_games"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_support_development"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:textAllCaps="true"
                app:backgroundTint="@color/support_button_background"
                app:cornerRadius="20dp"
                app:elevation="4dp"
                app:rippleColor="@color/primary"
                android:text="@string/btn_support_development" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
