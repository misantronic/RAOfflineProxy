<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_token_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_warning_box"
            android:lineSpacingMultiplier="1.15"
            android:padding="16dp"
            android:text="@string/home_token_warning"
            android:textColor="@color/warning_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Logo top-left, description text floats to its right and wraps below -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="12dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/tv_home_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/iv_logo"
                android:layout_alignParentTop="true"
                android:gravity="top"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginTop="12dp"
                android:text="@string/home_description" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_emulator_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/home_emulators_label"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_emulator_toggles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <include
                android:id="@+id/layout_retroarch_toggle"
                android:visibility="gone"
                layout="@layout/view_emulator_toggle" />

            <Space
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/layout_dolphin_toggle"
                android:visibility="gone"
                layout="@layout/view_emulator_toggle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="start"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_proxy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/proxy_start"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_go_to_cached_games"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/home_go_to_cached_games"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
