<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp"
    android:paddingEnd="16dp"
    android:paddingStart="16dp"
    android:paddingTop="16dp">

    <TextView
        android:id="@+id/tv_send_logs_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/send_logs_details_intro"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

    <CheckBox
        android:id="@+id/cb_send_logs_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/send_logs_details_label" />

    <LinearLayout
        android:id="@+id/layout_send_logs_details_fields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_send_logs_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/send_logs_details_email_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_send_logs_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_send_logs_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/send_logs_details_description_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_send_logs_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:maxLines="6" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</LinearLayout>
