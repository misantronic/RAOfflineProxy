<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RAOfflineProxy" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorControlActivated">@color/secondary</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.RAOfflineProxy.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.RAOfflineProxy.AlertDialog</item>
        <item name="actionBarStyle">@style/Widget.RAOfflineProxy.ActionBar</item>
        <item name="snackbarTextViewStyle">@style/Widget.RAOfflineProxy.SnackbarText</item>
        <item name="tabStyle">@style/Widget.RAOfflineProxy.TabLayout</item>
    </style>

    <style name="ThemeOverlay.RAOfflineProxy.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.RAOfflineProxy.AlertDialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.RAOfflineProxy.AlertDialog.Button.Neutral</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.RAOfflineProxy.AlertDialog.Button</item>
        <!-- Title panel and message-body panel both derive their horizontal padding from this
             single attribute, so overriding it here keeps them aligned with each other and with
             our custom setView() dialog layouts, which use the same 16dp padding. -->
        <item name="dialogPreferredPadding">16dp</item>
    </style>

    <style name="Widget.RAOfflineProxy.AlertDialog.Button" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/dialog_action</item>
    </style>

    <style name="Widget.RAOfflineProxy.AlertDialog.Button.Neutral" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/dialog_action_neutral</item>
    </style>

    <style name="Widget.RAOfflineProxy.SnackbarText" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.RAOfflineProxy.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="titleTextStyle">@style/TextAppearance.RAOfflineProxy.ActionBar.Title</item>
    </style>

    <style name="Widget.RAOfflineProxy.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabGravity">start</item>
        <item name="tabMode">scrollable</item>
    </style>

    <style name="Widget.RAOfflineProxy.Button.Icon" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minWidth">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconPadding">0dp</item>
    </style>

    <style name="TextAppearance.RAOfflineProxy.ActionBar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
