    <!-- Home fragment -->
    <string name="home_description">RAOfflineProxy acts as a local proxy between the emulator and RetroAchievements. It caches game data so you can play offline and earn achievements, then syncs them when you go back online. For setup instructions and tips, visit our documentation.</string>
    <string name="home_docs_url">https://raofflineproxy.com/introduction.html</string>
    <string name="home_emulators_label">Enabled Emulators</string>
    <string name="home_manual_setup_warning">With your Android version (%1$s), automatic emulator setup will most likely not work on this device. Please consider using Manual Emulator Setup instead. Android builds can differ, so you can still try Start proxy with automatic setup if you want.</string>
    <string name="home_shizuku_info">You are running the proxy through Shizuku.</string>
    <string name="home_no_emulator_warning">No supported emulator was found. Install RetroArch, Dolphin, PPSSPP, ARMSX2, Flycast, melonDualDS, Mupen64Plus, EmuCoreX, or ARMSX1 to use RAOfflineProxy.</string>
